{
  "name": "wendway",
  "version": "0.0.0",
  "description": "Keep your dotfiles in sync across machines",
  "type": "module",
  "bin": {
    "wendway": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "start": "tsx ./src/index.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarioCadenas/wendway.git"
  },
  "author": "Mario Cadenas (https://github.com/MarioCadenas)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MarioCadenas/wendway/issues"
  },
  "homepage": "https://github.com/MarioCadenas/wendway#readme",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/node": "^18.11.11",
    "release-it": "^20.2.1",
    "tsx": "^4.23.1",
    "typescript": "^4.9.4"
  }
}
